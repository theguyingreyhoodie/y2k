# Copy to backend/.env and adjust. Every value has a sensible local default.

MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=y2kedit

# Signs session cookies. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, a random secret is used and everyone is signed out on restart.
JWT_SECRET=

# Where the app is reachable. Used for links in password-reset emails.
PUBLIC_URL=http://localhost:5173

# Comma-separated. Stickers uploaded by these accounts are published to every user.
ADMIN_EMAILS=

# Optional: send real reset emails through Resend (https://resend.com). Without a key the link is logged.
RESEND_API_KEY=
EMAIL_FROM=Y2KEDIT <onboarding@resend.dev>

# Production behind HTTPS / a reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=false
SESSION_DAYS=14
# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=
